<Project>
  <!-- Shared across all three projects. TFMs are centralised here so they can be flipped in one
       place (the design calls for .NET 8 / x64). -->
  <PropertyGroup>
    <WinTfm>net8.0-windows</WinTfm>
    <NetTfm>net8.0</NetTfm>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- The design leans on the nullable contract (Snapshot null-emission, MaxDrive null semantics),
         so a nullability regression must fail the build even though other warnings stay non-fatal. -->
    <WarningsAsErrors>nullable</WarningsAsErrors>

    <!-- Target .NET 8 (LTS, per the design) but roll forward so the apps run on a machine that
         only has a newer shared framework (e.g. ASP.NET Core 9/10) installed. -->
    <RollForward>LatestMajor</RollForward>

    <!-- x64 only: LibreHardwareMonitor's WinRing0 driver is x64. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <Authors>TempMon</Authors>
    <Product>TempMon</Product>

    <!-- B-1: single source of truth for the version. Bump here, tag the matching vX.Y.Z. -->
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
  </PropertyGroup>
</Project>
