<Window x:Class="TempMon.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TempMon.Desktop.ViewModels"
        Title="TempMon" Height="840" Width="1000" MinWidth="720" MinHeight="560"
        Background="#0E0F13" Foreground="#F3F3F3"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!-- A summary tile: CPU / GPU / Max drive -->
    <DataTemplate x:Key="SummaryTile">
      <Border Background="#1F1F24" BorderBrush="#12FFFFFF" BorderThickness="1"
              CornerRadius="12" Padding="18,16" Margin="7,0">
        <StackPanel>
          <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                     Foreground="#73FFFFFF" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Bottom">
            <TextBlock Text="{Binding Value}" FontSize="40" FontWeight="SemiBold"
                       Foreground="{Binding Color}" />
            <TextBlock Text="°C" FontSize="16" Foreground="#66FFFFFF"
                       Margin="3,0,0,6" VerticalAlignment="Bottom" />
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- A single sensor sub-card (CPU / GPU / Motherboard) -->
    <DataTemplate DataType="{x:Type vm:SensorVM}">
      <Border Background="#26262B" BorderBrush="#0DFFFFFF" BorderThickness="1"
              CornerRadius="10" Padding="14,13" Margin="0,0,11,11">
        <StackPanel>
          <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#8CFFFFFF"
                     TextWrapping="Wrap" MinHeight="30" />
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Bottom">
            <TextBlock Text="{Binding Value}" FontSize="27" FontWeight="SemiBold"
                       Foreground="{Binding Color}" />
            <TextBlock Text="°C" FontSize="13" Foreground="#61FFFFFF"
                       Margin="2,0,0,4" VerticalAlignment="Bottom" />
          </StackPanel>
          <!-- progress bar: fill = BarStar, remainder = RestStar -->
          <Border Height="4" CornerRadius="99" Background="#12FFFFFF" Margin="0,10,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding BarStar}" />
                <ColumnDefinition Width="{Binding RestStar}" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" CornerRadius="99" Background="{Binding Color}" />
            </Grid>
          </Border>
          <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
            <TextBlock Text="{Binding Min}" FontSize="11" Foreground="#5CFFFFFF" Margin="0,0,12,0" />
            <TextBlock Text="{Binding Max}" FontSize="11" Foreground="#5CFFFFFF" />
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- A storage drive sub-card: headline = hottest sensor, every reading listed below (multi-sensor) -->
    <DataTemplate DataType="{x:Type vm:DriveCardVM}">
      <Border Background="#26262B" BorderBrush="#0DFFFFFF" BorderThickness="1"
              CornerRadius="10" Padding="14,13" Margin="0,0,11,11">
        <StackPanel>
          <TextBlock Text="{Binding Device}" FontSize="12" Foreground="#8CFFFFFF"
                     TextWrapping="Wrap" MinHeight="30" />
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Bottom">
            <TextBlock Text="{Binding Headline}" FontSize="27" FontWeight="SemiBold"
                       Foreground="{Binding HeadlineColor}" />
            <TextBlock Text="°C" FontSize="13" Foreground="#61FFFFFF"
                       Margin="2,0,0,4" VerticalAlignment="Bottom" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Readings}" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11.5"
                             Foreground="#8CFFFFFF" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" Margin="0,0,8,0" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Value}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{Binding Color}" />
                    <TextBlock Text="°C" FontSize="10" Foreground="#61FFFFFF"
                               Margin="2,0,0,1" VerticalAlignment="Bottom" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- A component card (CPU / GPU / Motherboard / Storage) -->
    <DataTemplate x:Key="ComponentCard">
      <Border Background="#1C1C20" BorderBrush="#0FFFFFFF" BorderThickness="1"
              CornerRadius="14" Padding="20,18" Margin="8">
        <StackPanel>
          <!-- header -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                    Background="#10FFFFFF" VerticalAlignment="Center">
              <TextBlock Text="{Binding Tag}" FontSize="11" FontWeight="Bold"
                         Foreground="#B8FFFFFF" HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                         Foreground="#F3F3F3" />
              <TextBlock Text="{Binding Device}" FontSize="12" Foreground="#73FFFFFF"
                         Margin="0,1,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="11.5"
                       Foreground="#61FFFFFF" VerticalAlignment="Center" />
          </Grid>
          <!-- sensors -->
          <ItemsControl ItemsSource="{Binding Items}" Margin="0,15,-11,-11">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Not-elevated banner -->
    <Border Grid.Row="0" Visibility="{Binding BannerVisibility}"
            Margin="20,18,20,0" Background="#1FEAB54E" BorderBrush="#59EAB54E"
            BorderThickness="1" CornerRadius="10" Padding="16,13">
      <DockPanel>
        <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="7"
                Background="#33EAB54E" VerticalAlignment="Center">
          <TextBlock Text="!" Foreground="#EAB54E" FontWeight="Bold" FontSize="15"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Button DockPanel.Dock="Right" Content="Restart as admin" Click="RestartAsAdmin_Click"
                VerticalAlignment="Center" Foreground="#0B1620" FontWeight="SemiBold"
                FontSize="12.5" Padding="16,8" BorderThickness="0" Cursor="Hand">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border Background="#60CDFF" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Button.Template>
        </Button>
        <StackPanel Margin="14,0" VerticalAlignment="Center">
          <TextBlock Text="Running without administrator rights" FontSize="13"
                     FontWeight="SemiBold" Foreground="#F3F3F3" />
          <TextBlock Text="Sensors require elevation — all temperatures will read null until you restart elevated."
                     FontSize="12" Foreground="#8CFFFFFF" Margin="0,1,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Summary strip -->
    <ItemsControl Grid.Row="1" ItemsSource="{Binding SummaryTiles}" Margin="13,18,13,0"
                  ItemTemplate="{StaticResource SummaryTile}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="3" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>

    <!-- Component cards -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="12,16,12,0"
                  Padding="0,0,0,8">
      <ItemsControl ItemsSource="{Binding Components}" ItemTemplate="{StaticResource ComponentCard}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </ScrollViewer>

    <!-- Status bar -->
    <Border Grid.Row="3" Background="#16171C" BorderBrush="#0FFFFFFF" BorderThickness="0,1,0,0"
            Padding="24,11">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="7" Height="7" Fill="{Binding ElevationDot}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ElevationText}" Margin="8,0,0,0" FontSize="11.5"
                     FontWeight="Medium" Foreground="#B3FFFFFF" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="6" Height="6" Fill="#4CC38A" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Endpoint, StringFormat={}{0}/temps}" Margin="7,0,0,0"
                     FontSize="11.5" FontFamily="Cascadia Code, Consolas"
                     Foreground="#8CFFFFFF" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Column="2" Text="{Binding PollText}" HorizontalAlignment="Right"
                   FontSize="11.5" Foreground="{Binding PollBrush}" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
