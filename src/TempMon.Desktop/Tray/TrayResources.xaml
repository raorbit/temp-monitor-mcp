<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Hover style for a flyout row: transparent until the pointer is over it, then a faint wash.
       Rows are Borders so the factory can hook MouseLeftButtonUp by name. -->
  <Style x:Key="TrayRow" TargetType="Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="Cursor" Value="Hand" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#12FFFFFF" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- The dark flyout shown above the tray icon. DataContext is the shared DashboardViewModel. -->
  <ControlTemplate x:Key="TrayFlyout" TargetType="ContentControl">
    <Border Background="#161619" BorderBrush="#1F1F24" BorderThickness="1"
            CornerRadius="12" Padding="8" Width="240"
            TextOptions.TextFormattingMode="Display"
            TextElement.FontFamily="Segoe UI Variable Display, Segoe UI"
            TextElement.Foreground="#F3F3F3">
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55" Color="#000000" />
      </Border.Effect>
      <StackPanel>

        <!-- Header: gradient logo + name on the left, live CPU temp on the right. -->
        <Grid Margin="6,6,6,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7"
                  VerticalAlignment="Center">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#60CDFF" Offset="0" />
                <GradientStop Color="#4CC38A" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>

          <TextBlock Grid.Column="1" Text="TempMon" Margin="10,0,0,0"
                     FontSize="14" FontWeight="SemiBold" Foreground="#F3F3F3"
                     VerticalAlignment="Center" />

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding CpuTrayText}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{Binding CpuTrayBrush}" VerticalAlignment="Center" />
            <TextBlock Text="°C" FontSize="11" Foreground="#66FFFFFF"
                       Margin="2,0,0,2" VerticalAlignment="Bottom" />
          </StackPanel>
        </Grid>

        <Border Height="1" Background="#1F1F24" Margin="6,6,6,6" />

        <!-- Open dashboard -->
        <Border x:Name="OpenRow" Style="{StaticResource TrayRow}">
          <TextBlock Text="Open dashboard" FontSize="13" Foreground="#F3F3F3" />
        </Border>

        <!-- Auto-start toggle; the leading glyph appears only when AutoStartEnabled is true. -->
        <Border x:Name="AutoStartRow" Style="{StaticResource TrayRow}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="18" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Check" Grid.Column="0" Text="✓" FontSize="13"
                       Foreground="#4CC38A" Visibility="Collapsed"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Auto-start at logon" FontSize="13"
                       Foreground="#F3F3F3" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <Border Height="1" Background="#1F1F24" Margin="6,6,6,6" />

        <!-- Exit -->
        <Border x:Name="ExitRow" Style="{StaticResource TrayRow}">
          <TextBlock Text="Exit" FontSize="13" Foreground="#F0616D" />
        </Border>
      </StackPanel>
    </Border>

    <ControlTemplate.Triggers>
      <DataTrigger Binding="{Binding AutoStartEnabled}" Value="True">
        <Setter TargetName="Check" Property="Visibility" Value="Visible" />
      </DataTrigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

</ResourceDictionary>
