<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(WinTfm)</TargetFramework>
    <RootNamespace>TempMon.Desktop.Tests</RootNamespace>
    <AssemblyName>TempMon.Desktop.Tests</AssemblyName>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Covers the cross-process discovery contract (endpoint.json round-trip) and the in-process
         Kestrel /temps + /health routes — the host the elevated desktop exposes to the MCP server. -->
  </PropertyGroup>

  <!-- The route tests stand up the in-process Kestrel server (TempServer). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- References both halves: EndpointFile (writer, Desktop) round-trips into EndpointResolver
         (reader, Mcp). Referencing the desktop WinExe and the MCP host from a test project is fine. -->
    <ProjectReference Include="..\TempMon.Desktop\TempMon.Desktop.csproj" />
    <ProjectReference Include="..\TempMon.Mcp\TempMon.Mcp.csproj" />
  </ItemGroup>

</Project>
