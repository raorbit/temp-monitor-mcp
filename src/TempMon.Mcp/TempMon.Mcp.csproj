<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(NetTfm)</TargetFramework>
    <RootNamespace>TempMon.Mcp</RootNamespace>
    <AssemblyName>TempMon.Mcp</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- No admin, no hardware: this process only reads a file and HTTP-GETs localhost. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions pinned via `dotnet add package` (resolved decision #4). -->
    <PackageReference Include="Microsoft.Extensions.Hosting">
      <Version>10.0.9</Version>
    </PackageReference>
    <PackageReference Include="ModelContextProtocol">
      <Version>1.4.0</Version>
    </PackageReference>
  </ItemGroup>

</Project>
